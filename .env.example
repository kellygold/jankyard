# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jankyard

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Environment
ENVIRONMENT=development

# LLM API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-6-luna

# Rate Limiting
RATE_LIMIT_ENABLED=true
SUBMISSIONS_PER_MINUTE=40
SUBMISSIONS_PER_DAY=100

# Shared site-wide admission ceiling; includes failed turns and retries.
# Every public game permits at most one provider call per admitted stage.
RECOVERED_TURNS_PER_DAY=1000
# Guest provisioning is a separate peer-based budget.
GUEST_SESSIONS_PER_MINUTE=1000
GUEST_SESSIONS_PER_DAY=10000
