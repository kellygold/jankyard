# Google App Engine configuration for Jankyard.ai
# Copy this to app.yaml and fill in your actual values

service: jankyard
runtime: python311
entrypoint: gunicorn -w 2 -k uvicorn.workers.UvicornWorker --timeout 300 --keep-alive 75 --graceful-timeout 300 --worker-tmp-dir /dev/shm app.main:app

instance_class: F1

handlers:
  # Serve static files directly (bypass Python app)
  - url: /static
    static_dir: app/static
    secure: always
  
  # Everything else goes to the Python app
  - url: /.*
    script: auto
    secure: always

env_variables:
  DATABASE_URL: "postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"
  SECRET_KEY: "your-secret-key-here-generate-a-random-string"
  ENVIRONMENT: "production"
  OPENAI_API_KEY: "sk-proj-your-openai-api-key-here"
  ANTHROPIC_API_KEY: "sk-ant-api03-your-anthropic-api-key-here"
  DEFAULT_LLM_PROVIDER: "openai"
  DEFAULT_MODEL: "gpt-4o-mini"
  RATE_LIMIT_ENABLED: "true"
  SUBMISSIONS_PER_MINUTE: "10"
  SUBMISSIONS_PER_DAY: "100"

automatic_scaling:
  target_cpu_utilization: 0.65
  min_instances: 0
  max_instances: 8
#Always keep a healthy max of instances over uvicorn workers or startup dies
